# One TOC for every client (ALL-15, 2026-11-16): Retail, WoW Forever, Mists Classic,
# TBC Anniversary and Classic Era all load this file. Client-only files gate themselves
# at load: ClassicCompat.lua returns at once unless the client is Classic, and
# MultilineBox.lua returns at once on Classic. Forever is the Retail client, not Classic.

# Bootstrap
Init.lua

# Classic compatibility shim (must load right after Init.lua; does nothing off Classic)
Compat\ClassicCompat.lua

# Libraries
libs\libs.xml

# Utilities (keybinding globals + helpers)
Utils\Utils.lua
Utils\Encoding.lua

# Locales
Locales\enUS.lua
Locales\deDE.lua
Locales\frFR.lua
Locales\esES.lua
Locales\ptBR.lua
Locales\itIT.lua
Locales\jaJP.lua
Locales\koKR.lua
Locales\zhCN.lua
Locales\zhTW.lua

# Core systems (order matters!)
Core\Constants.lua
Core\Database.lua
Core\Security.lua
Core\Events.lua
Core\SlashCommands.lua
Core\Initialize.lua

# Editbox (the heart of the addon)
Editbox\Editbox.lua
Editbox\ChannelDisplay.lua
Editbox\LinkInsertion.lua
Editbox\ChatIntercept.lua
Editbox\SendMessage.lua
Editbox\History.lua
Editbox\Handlers.lua

